# Copy this file to `.env.local` and replace the values with your own
# from Supabase Dashboard > Project Settings > API.
#
# `.env.local` is git-ignored, so your real keys stay on your machine.
# Never commit real keys. The `anon` key is safe to expose in the browser,
# access is controlled by Row Level Security in your Supabase project.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
